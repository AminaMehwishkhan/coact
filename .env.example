# ---- Speechmatics (optional) ----------------------------------------------
# With a key the backend mints short-lived real-time JWTs for the browser and
# the UI reads LIVE SPEECHMATICS. Without one, corrections replay through the
# same pipeline and the UI reads DEMO REPLAY. The long-lived key is never sent
# to the browser and must never be committed.
SPEECHMATICS_API_KEY=
SPEECHMATICS_RT_URL=wss://eu2.rt.speechmatics.com/v2

# ---- OpenVINO -------------------------------------------------------------
# AUTO | CPU | GPU | NPU. AUTO lets OpenVINO pick; the UI reports what it
# actually resolved to, never what we hoped for.
COACT_OV_DEVICE=AUTO

# ---- Simulation -----------------------------------------------------------
# GL backend. egl is the headless default and is set by the package on import.
MUJOCO_GL=egl
# Set to 1 to run without physics, for testing the degraded path.
# COACT_FORCE_NULL_RUNTIME=1

# ---- Server ---------------------------------------------------------------
PORT=8000
